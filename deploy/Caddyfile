# 把 api.example.com 换成你的域名，Caddy 会自动申请 HTTPS 证书。
api.example.com {
	# 管理台只允许你自己的 IP（改成你的公网 IP），其他人访问 /admin 直接 404
	@admin_blocked {
		path /admin*
		not remote_ip 203.0.113.10
	}
	respond @admin_blocked 404

	reverse_proxy 127.0.0.1:9880 {
		# SSE 必须立即转发，不能缓冲，否则首 token 延迟全废
		flush_interval -1
		transport http {
			read_timeout 10m
		}
	}
}
