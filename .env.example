# 复制为 .env 后填写。不要在值后面写注释（systemd 的 EnvironmentFile 不会去掉行尾注释）。

# 上游：缺哪个，对应渠道自动不参与路由
DEEPSEEK_API_KEY=
GLM_PLAN_API_KEY=
OPENCODE_GO_API_KEY=

# 管理台登录口令，用 python -c "import secrets;print(secrets.token_hex(32))" 生成
THALAMUS_ADMIN_TOKEN=

# 控制台来源白名单，逗号分隔的 IP 或 CIDR。留空 = 只靠反代白名单。
# 填了之后 /admin 与 /admin/api/* 对名单外来源一律 404（纵深防御，不依赖反代配对）。
THALAMUS_ADMIN_ALLOW=

THALAMUS_HOST=127.0.0.1
THALAMUS_PORT=9880
THALAMUS_DB=./data/thalamus.db
THALAMUS_LOG_LEVEL=INFO
THALAMUS_WARM=1
